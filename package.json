{
  "name": "blogs-api",
  "version": "0.1.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "engineStrict": true,
  "private": true,
  "dependencies": {
    "@prisma/client": "5.22.0",
    "dotenv": "8.2.0",
    "express": "4.17.1",
    "express-async-errors": "3.1.1",
    "joi": "17.6.0",
    "jsonwebtoken": "8.5.1",
    "morgan": "1.10.0",
    "shelljs": "0.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "build:render": "prisma generate --schema=prisma/schema.sqlite.prisma && tsc",
    "setup:render": "prisma db push --schema=prisma/schema.sqlite.prisma && npm run prisma:seed",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "seed": "npm run prisma:seed",
    "start": "node dist/server.js",
    "debug": "npm run dev",
    "lint": "eslint --no-inline-config --no-error-on-unmatched-pattern -c .eslintrc.json ."
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.1",
    "@types/swagger-ui-express": "^4.1.8",
    "change-case": "4.1.2",
    "eslint": "6.8.0",
    "eslint-config-airbnb-base": "14.2.0",
    "eslint-config-trybe-backend": "1.0.3",
    "eslint-plugin-import": "2.22.1",
    "frisby": "2.1.2",
    "jest": "26.0.1",
    "jest-each": "28.0.1",
    "nodemon": "2.0.15",
    "prisma": "5.22.0",
    "supertest": "4.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "wait-on": "6.0.1"
  }
}
